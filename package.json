{
  "name": "context-launch",
  "version": "0.1.2",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node scripts/serve.mjs",
    "format": "node scripts/format-typescript.mjs --write && prettier --write \"**/*.{js,jsx,cjs,mjs,ts,tsx,cts,mts,css,html,json}\" --ignore-path .gitignore --ignore-path .prettierignore",
    "format:check": "node scripts/format-typescript.mjs && prettier --check \"**/*.{js,jsx,cjs,mjs,ts,tsx,cts,mts,css,html,json}\" --ignore-path .gitignore --ignore-path .prettierignore",
    "lint": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/eslint/.eslintcache && oxlint .",
    "check": "pnpm run test",
    "check:unused": "tsx scripts/unused-code.ts",
    "check:unused:ts": "tsx scripts/unused-code-ts.ts",
    "check:full": "pnpm run format && tsc --noEmit && pnpm run lint && pnpm run check",
    "test": "node scripts/test.mjs",
    "bench": "node scripts/run-tests.mjs bench",
    "electron:build-main": "esbuild electron/main.ts --bundle --platform=node --format=esm --outfile=electron/main.js --external:electron && esbuild electron/preload.ts --bundle --platform=node --format=cjs --outfile=electron/preload.cjs --external:electron",
    "electron:start": "electron electron/main.js",
    "electron:dist": "tsx scripts/electron-dist.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-markdown": "6.5.0",
    "@codemirror/language": "6.12.4",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/search": "6.7.1",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.8",
    "@fontsource/inter": "5.2.8",
    "@fontsource/jetbrains-mono": "5.2.8",
    "@lezer/highlight": "1.2.3",
    "@pierre/diffs": "1.2.12",
    "@solidjs/router": "2.0.0-next.16",
    "@solidjs/web": "2.0.0-rc.1",
    "chokidar": "5.0.0",
    "codemirror": "6.0.2",
    "lucide": "1.31.0",
    "solid-js": "2.0.0-rc.1",
    "valibot": "1.4.1"
  },
  "devDependencies": {
    "@babel/generator": "8.0.0",
    "@babel/parser": "8.0.4",
    "@eslint/js": "10.0.1",
    "@oxlint/plugins": "1.80.0",
    "@solidjs/vite-plugin": "3.0.0-next.31",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tailwindcss/vite": "4.3.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@total-typescript/shoehorn": "0.1.2",
    "@types/jsdom": "30.0.0",
    "@types/node": "25.9.1",
    "@typescript-eslint/utils": "8.60.0",
    "babel-preset-solid": "2.0.0-rc.1",
    "electron": "42.4.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.1",
    "eslint": "10.4.1",
    "jsdom": "29.1.1",
    "memfs": "4.57.2",
    "oxlint": "1.80.0",
    "playwright": "1.60.0",
    "prettier": "3.6.2",
    "tailwindcss": "4.3.0",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.60.0",
    "vite": "7.3.5",
    "vitest": "3.2.6"
  }
}
