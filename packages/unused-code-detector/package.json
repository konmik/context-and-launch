{
  "name": "@inspection/unused-code-detector",
  "version": "0.1.0",
  "type": "module",
  "description": "Reusable LSP-based unused and test-only code inspection",
  "files": ["dist", "src", "README.md"],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./files": {
      "source": "./src/files.ts",
      "types": "./dist/files.d.ts",
      "import": "./dist/files.js"
    },
    "./typescript": {
      "source": "./src/typescript/index.ts",
      "types": "./dist/typescript/index.d.ts",
      "import": "./dist/typescript/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "valibot": "1.4.1",
    "vscode-jsonrpc": "9.0.3",
    "vscode-languageserver-protocol": "3.18.4"
  },
  "peerDependencies": {
    "typescript": "5.9.3",
    "typescript-language-server": "5.3.0"
  },
  "peerDependenciesMeta": {
    "typescript": { "optional": true },
    "typescript-language-server": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "typescript": "5.9.3",
    "typescript-language-server": "5.3.0"
  },
  "engines": { "node": ">=22.18.0" }
}
